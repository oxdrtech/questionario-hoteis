{
  "name": "Painel de leads (webhook)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "painel",
        "responseMode": "lastNode",
        "options": {
          "allowedOrigins": "*"
        }
      },
      "id": "d1e0a3c2-1d2e-4f5a-9b6c-7d8e9f0a1b01",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "painel-hoteis"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Troque a senha abaixo. É a mesma que você digita no painel.html\nconst SENHA = 'TROQUE_ESTA_SENHA';\n\nconst body = $input.first().json.body || {};\nif (String(body.senha ?? '').trim() !== SENHA.trim()) throw new Error('Senha incorreta: recebi ' + (body.senha ? body.senha.length + ' caracteres' : 'nenhuma senha'));\nconst { senha, ...pedido } = body;\nreturn [{ json: { pedido: JSON.stringify(pedido) } }];"
      },
      "id": "d1e0a3c2-1d2e-4f5a-9b6c-7d8e9f0a1b02",
      "name": "Checar senha",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT painel($1::jsonb) AS dados;",
        "options": {
          "queryReplacement": "={{ [ $json.pedido ] }}"
        }
      },
      "id": "d1e0a3c2-1d2e-4f5a-9b6c-7d8e9f0a1b03",
      "name": "Consultar painel",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        440,
        0
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Checar senha",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Checar senha": {
      "main": [
        [
          {
            "node": "Consultar painel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
